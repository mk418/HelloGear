<Bindings>
    <!-- Equipping gear is not protected in Classic Era, so these call straight
         into Lua. Which set each one equips is assigned with /hg bind. -->
    <Binding name="HELLOGEAR_MENU" header="HELLOGEAR" category="ADDONS">
        HelloGear.ToggleMenu()
    </Binding>
    <Binding name="HELLOGEAR_SET1" category="ADDONS">
        HelloGear.EquipBoundSet(1)
    </Binding>
    <Binding name="HELLOGEAR_SET2" category="ADDONS">
        HelloGear.EquipBoundSet(2)
    </Binding>
    <Binding name="HELLOGEAR_SET3" category="ADDONS">
        HelloGear.EquipBoundSet(3)
    </Binding>
    <Binding name="HELLOGEAR_SET4" category="ADDONS">
        HelloGear.EquipBoundSet(4)
    </Binding>
    <Binding name="HELLOGEAR_SET5" category="ADDONS">
        HelloGear.EquipBoundSet(5)
    </Binding>
    <Binding name="HELLOGEAR_SET6" category="ADDONS">
        HelloGear.EquipBoundSet(6)
    </Binding>
</Bindings>
